# ============================================================
# FinTrack v2 — root compose environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Database ---
POSTGRES_PASSWORD=postgres
# Password for the least-privilege application role (fintrack_app).
APP_DB_PASSWORD=change-me

# --- Auth ---
# HS256 secret, minimum 32 characters. Shared by backend + frontend.
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
COOKIE_SECURE=false

# --- Encryption ---
# 64 hex chars (32 bytes). KEEP the v1 value so existing keys stay decryptable.
ENCRYPTION_KEY=7b4c92f1d8e3a6b5c2d4f9e8a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0

# --- Redis (cache berversi + pub/sub) ---
# Host port 6380 (6379 dipakai stack lain di mesin dev). Internal container tetap 6379.
# Kosongkan untuk menonaktifkan cache (graceful degradation).
REDIS_URL=redis://localhost:6380/0

# --- RAG embeddings ---
# Legacy direct-Gemini embedder, used only when the centralized gateway is off.
GEMINI_EMBEDDING_API_KEY=

# --- AI Gateway (centralized endpoint pool, P03) ---
# These are BOOTSTRAP DEFAULTS: they only seed the database the FIRST time the
# platform starts against an EMPTY `ai_endpoints` / `ai_routes` / feature flag.
# Once the Super Admin configures the gateway via /super-admin/ai-gateway, the
# database is authoritative and these values are ignored (never used to
# overwrite an operator decision).
#
# Set AI_GATEWAY_BASE_URL to enable bootstrapping; leave empty to skip it and
# configure everything manually from the Super Admin UI.
#   AI_GATEWAY_BASE_URL   OpenAI-compatible API root, e.g. http://127.0.0.1:20128/v1
#   AI_GATEWAY_API_KEY    upstream key (stored AES-256-GCM encrypted at rest)
#   AI_GATEWAY_ENABLED    true = seed feature_ai_gateway_centralized ON (rollout 100)
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_ENDPOINT_NAME=9router-primary
AI_GATEWAY_PROVIDER=9router
AI_GATEWAY_ENABLED=false

# Default upstream model per gateway use case (seeded only when ai_routes is empty).
AI_GATEWAY_MODEL_CHAT=gemini/gemini-3.5-flash-lite
AI_GATEWAY_MODEL_REASONING=deepseek-r1
AI_GATEWAY_MODEL_VISION=gemini/gemini-3.5-flash
AI_GATEWAY_MODEL_VOICE=whisper-1
AI_GATEWAY_MODEL_EMBEDDING=gemini/gemini-embedding-001

# Per-route upstream timeout (ms) seeded for each use case when ai_routes is
# empty. Vision (receipt OCR) and voice transcription need a generous ceiling:
# the model has to read the media and answer, which routinely exceeds 30s.
#
# NOTE: these are BOOTSTRAP/ENV DEFAULTS only. The live budget is the dynamic
# `ai_timeout_*_ms` settings rows, editable from Super Admin → Pengaturan →
# "Batas Waktu AI" and applied to the running fleet within seconds (no restart).
# Precedence: settings row > these env vars > ai_routes.timeout_ms > default.
AI_GATEWAY_TIMEOUT_CHAT_MS=60000
AI_GATEWAY_TIMEOUT_VISION_MS=120000
AI_GATEWAY_TIMEOUT_VOICE_MS=120000
AI_GATEWAY_TIMEOUT_REASONING_MS=120000

# Default per-call timeout (seconds) used when a route has no timeout_ms.
AI_GATEWAY_TIMEOUT=90

# Dynamic AI timeout budget (ms), used when the corresponding settings row is
# absent. Set these only for a deployment that must ship a non-default budget
# before anyone opens the Super Admin UI; otherwise leave unset and tune from the
# UI. AI_TIMEOUT_CLIENT_MS is the browser budget (0/absent = auto).
AI_TIMEOUT_CHAT_MS=
AI_TIMEOUT_VISION_MS=
AI_TIMEOUT_VOICE_MS=
AI_TIMEOUT_EMBEDDING_MS=
AI_TIMEOUT_REASONING_MS=
AI_TIMEOUT_CLIENT_MS=

# --- AI Assistant reasoning mode ---
# Sent as `reasoning_effort` upstream when the user picks PENALARAN (reasoning)
# mode. Allowed: low | medium | high. Leave empty to route reasoning requests to
# the reasoning route pool WITHOUT sending the field — some OpenAI-compatible
# providers reject `reasoning_effort` for models that do not support it.
AI_REASONING_EFFORT=

# --- Entitlement / RBAC (P07 slice A) ---
# Plan assigned to users with no subscription row (default: free).
# Set empty to restore deny-all for such users.
DEFAULT_PLAN_CODE=free
# Plan enforcement on user routes. Set to off/false/0 ONLY during an incident:
# it disables feature and limit checks entirely (operational bypass).
ENTITLEMENT_ENFORCEMENT=on

# --- Graceful shutdown (P07 slice D1) ---
# Seconds to drain in-flight requests on SIGTERM before exit. Keep >= the
# orchestrator's termination grace period (compose uses stop_grace_period: 30s).
SHUTDOWN_TIMEOUT=30

# --- HTTP server timeouts (seconds) ---
# ReadTimeout bounds how long the client may take to send the request; it must
# exceed the slowest upload (receipt images are up to 2 MB).
# WriteTimeout is the whole-response budget. It is raised well above the slowest
# AI call so a healthy-but-slow vision/voice answer is not severed. Long-lived
# AI/SSE routes additionally clear this deadline per-request, so this only needs
# to cover ordinary CRUD.
HTTP_READ_TIMEOUT=60
HTTP_WRITE_TIMEOUT=120
HTTP_IDLE_TIMEOUT=60

# --- Realtime SSE (P07 slice B) ---
# Stream endpoint + event publishing. Set to off/false/0 ONLY during an incident:
# the endpoint returns 503 and publishing becomes a no-op.
REALTIME_ENABLED=on

# --- Payment / storage / AI (see backend/.env.example) ---
# These are DEFAULTS; the Super Admin UI can override them at runtime (DB wins).
# MIDTRANS_ENABLED / MIDTRANS_SERVER_KEY / MIDTRANS_CLIENT_KEY / MIDTRANS_IS_PRODUCTION
# MANUAL_BANK_NAME / MANUAL_ACCOUNT_NUMBER / MANUAL_ACCOUNT_HOLDER
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY / R2_BUCKET / R2_REGION
# R2_ENDPOINT / R2_PREFIX / R2_PUBLIC_BASE_URL
# AI_REASONING_EFFORT
