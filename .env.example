# ============================================================
# FinTrack v2 — root compose environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Database ---
POSTGRES_PASSWORD=postgres
# Password for the least-privilege application role (fintrack_app).
APP_DB_PASSWORD=change-me

# --- Auth ---
# HS256 secret, minimum 32 characters. Shared by backend + frontend.
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
COOKIE_SECURE=false

# --- Encryption ---
# 64 hex chars (32 bytes). KEEP the v1 value so existing keys stay decryptable.
ENCRYPTION_KEY=7b4c92f1d8e3a6b5c2d4f9e8a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0

# --- Redis (cache berversi + pub/sub) ---
# Host port 6380 (6379 dipakai stack lain di mesin dev). Internal container tetap 6379.
# Kosongkan untuk menonaktifkan cache (graceful degradation).
REDIS_URL=redis://localhost:6380/0

# --- RAG embeddings ---
GEMINI_EMBEDDING_API_KEY=

# --- Entitlement / RBAC (P07 slice A) ---
# Plan assigned to users with no subscription row (default: free).
# Set empty to restore deny-all for such users.
DEFAULT_PLAN_CODE=free
# Plan enforcement on user routes. Set to off/false/0 ONLY during an incident:
# it disables feature and limit checks entirely (operational bypass).
ENTITLEMENT_ENFORCEMENT=on
