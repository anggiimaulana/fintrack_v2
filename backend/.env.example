# ============================================================
# FinTrack v2 — backend environment
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# --- Database ---
# Uses the least-privilege application role (no DDL).
DATABASE_URL=postgres://fintrack_app:<APP_DB_PASSWORD>@localhost:5435/fintrack
APP_DB_PASSWORD=change-me

# --- Auth ---
# HS256 secret, minimum 32 characters. Shared with the frontend (server-only).
JWT_SECRET=change-me-to-a-random-32-plus-char-secret
# Set true only when serving over HTTPS (adds Secure to auth cookies).
COOKIE_SECURE=false

# --- Encryption ---
# 64 hex chars (32 bytes) for encrypting stored provider API keys.
# KEEP the v1 value so existing encrypted keys remain decryptable.
ENCRYPTION_KEY=7b4c92f1d8e3a6b5c2d4f9e8a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0

# --- RAG embeddings (global server key) ---
GEMINI_EMBEDDING_API_KEY=

# --- HTTP / CORS ---
CORS_ORIGIN=http://localhost:3001
PORT=8080
LOG_LEVEL=info

# --- Connection pool ---
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100

# --- Proof storage (payment transfer proofs + user avatars) ---
# Default driver for NEW uploads: "local" | "r2". Can be switched at runtime from
# the Super Admin > Pengaturan page (settings key: storage_driver).
STORAGE_DRIVER=local
# Local driver root directory (relative paths resolve against the process cwd).
STORAGE_LOCAL_DIR=./uploads

# --- Cloudflare R2 (S3-compatible). Leave blank to keep R2 disabled. ---
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET=fintrack-uploads
# R2_REGION=auto
# Optional: override the derived endpoint (defaults to https://<account>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# Optional: key prefix inside the bucket
# R2_PREFIX=fintrack
# Optional: public bucket URL (custom domain or r2.dev) for direct object links
# R2_PUBLIC_BASE_URL=
